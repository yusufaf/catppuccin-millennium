---
whiskers:
    version: ^2.9.0
    matrix:
        - flavor
    filename: "src/flavors/{{ flavor.identifier }}.css"
---
/* Catppuccin {{ flavor.name }} — generated by whiskers, do not edit by hand. */
:root {
{%- for id, color in flavor.colors %}
    --ctp-{{ id }}: #{{ color.hex }};
{%- endfor %}
}
